{
  // Static Astro build served by Cloudflare Workers static assets.
  "name": "glowinthedirt",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": "./dist",
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  // Serve previews on workers.dev too.
  "preview_urls": true,
  // Lets `wrangler preview` make a preview URL for each pull request.
  "previews": {}
}
